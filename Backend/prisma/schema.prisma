generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  googleSub    String?  @unique
  googleEmail  String?
  suiAddress   String?  @unique
  zkLoginSalt  Bytes?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nftMints NftMint[] @relation("NftMintUser")
  orders Order[]
  authSessions AuthSession[]

  @@index([email])
  @@index([suiAddress])
}

enum OrderStatus {
  PENDING
  PAID
  SHOPIFY_CREATED
  SHOPIFY_FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ProviderOperationStatus {
  NOT_STARTED
  PENDING
  SUCCEEDED
  FAILED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  email           String
  userId          String?     @db.Uuid
  stripeSessionId String      @unique
  stripePaymentId String?     @unique
  stripeRefundId  String?     @unique
  shopifyOrderId  String?     @unique
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  shopifyStatus   ProviderOperationStatus @default(NOT_STARTED)
  refundStatus    ProviderOperationStatus @default(NOT_STARTED)
  lastError       String?
  currency        String      @default("USD")
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  shippingAddress Json?
  refundedAt      DateTime?
  hiddenAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  nftMints NftMint[]
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  shopifyVariantGid String?
  title             String?
  sku               String?
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  discountApplied   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  nftMint NftMint?

  @@index([orderId])
  @@index([shopifyVariantGid])
}

enum ProductKind {
  BOWL
  SHOPIFY
}

enum MintStatus {
  PENDING
  MINTING
  MINTED
  FAILED
}

model NftMint {
  id                  String       @id @default(uuid()) @db.Uuid
  orderId             String       @db.Uuid
  orderItemId         String       @unique @db.Uuid
  userId              String       @db.Uuid
  productKind         ProductKind
  /// Serial of the physical bowl (1..101). Unique so a serial can never get
  /// two mint rows; the on-chain MintCap bitmap is the final guard.
  bowlSerial          Int?         @unique
  /// Snapshot of the singing_bowl::mint(...) inputs, captured from Shopify
  /// metafields at order time so minting never depends on Shopify uptime.
  mintPayload         Json?
  shopifyVariantGid   String?
  recipientSuiAddress String
  sponsoredByAddress  String?
  status              MintStatus   @default(PENDING)
  attempts            Int          @default(0)
  lastError           String?
  suiObjectId         String?      @unique
  mintTxDigest        String?
  scheduledAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user      User      @relation("NftMintUser", fields: [userId], references: [id])

  @@index([status, scheduledAt])
  @@index([orderId])
  @@index([userId])
}

model AuthSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum WebhookProcessingStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

model WebhookEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  provider    String
  externalId  String
  type        String
  status      WebhookProcessingStatus @default(PROCESSING)
  attempts    Int                     @default(1)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([provider, externalId])
  @@index([status, createdAt(sort: Desc)])
}

